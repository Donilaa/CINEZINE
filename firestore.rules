rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------
    function signedIn() { return request.auth != null; }

    // Quién puede escribir en el muro (publicar, comentar, votar):
    // Exige sesión iniciada + correo electrónico verificado.
    function canWrite() { return signedIn() && request.auth.token.email_verified == true; }

    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Autoría (las publicaciones antiguas de prueba usaban "userId")
    function ownerOf(data) { return data.get('authorUid', data.get('userId', '')); }

    // Un voto solo puede tocar la entrada de quien lo emite, con un valor válido
    function onlyMyVote() {
      return request.resource.data.votes.diff(resource.data.get('votes', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.votes)
            || request.resource.data.votes[request.auth.uid] in ['agree', 'disagree']);
    }

    // ---------- Datos privados de cada persona ----------
    match /users/{uid}/{document=**} {
      allow read, write: if isUser(uid);
    }

    // ---------- Ficha pública (nombre, avatar, bio, library pública) ----------
    // Incluye 'publicLists' y 'stats' como campos heredados tolerados mientras se limpian con deleteField()
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isUser(uid)
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
             'username', 'avatarSeed', 'bio', 'library', 'updatedAt',
             'publicLists', 'stats'
           ])
        && request.resource.data.get('username', '').size() <= 40
        && request.resource.data.get('avatarSeed', '').size() <= 60
        && request.resource.data.get('bio', '').size() <= 300
        && (!('library' in request.resource.data)
            || (request.resource.data.library is map
                && request.resource.data.library.keys().hasOnly([
                     'cine_watched_movies',
                     'cine_watched_movies_data',
                     'cine_personal_reviews',
                     'cine_custom_lists'
                   ])))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isUser(uid);

      // Subdocumento dedicado para biblioteca pública resumida
      match /public/{docId} {
        allow read: if true;
        allow create, update: if isUser(uid)
          && request.auth.token.email_verified == true
          && docId == 'library'
          && request.resource.data.keys().hasOnly(['library', 'updatedAt'])
          && request.resource.data.library is map
          && request.resource.data.library.keys().hasOnly([
               'cine_watched_movies',
               'cine_watched_movies_data',
               'cine_personal_reviews',
               'cine_custom_lists'
             ])
          && request.resource.data.updatedAt == request.time;
        allow delete: if isUser(uid);
      }
    }

    // ---------- Notificaciones dedicadas por destinatario ----------
    match /notifications/{recipientUid}/items/{notifId} {
      allow read: if isUser(recipientUid);

      allow create, update: if (
        // El emisor crea/actualiza la notificación al votar o comentar
        ( canWrite()
          && recipientUid != request.auth.uid
          && request.resource.data.keys().hasOnly([
               'type', 'fromUid', 'fromName', 'fromAvatarSeed',
               'postId', 'postLabel', 'commentId', 'text', 'read', 'createdAt'
             ])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type in ['vote', 'comment', 'reply', 'comment_vote']
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 40
          && request.resource.data.fromAvatarSeed is string
          && request.resource.data.fromAvatarSeed.size() <= 60
          && request.resource.data.postId is string
          && request.resource.data.postId.size() <= 80
          && request.resource.data.postLabel is string
          && request.resource.data.postLabel.size() <= 160
          && (request.resource.data.commentId == null
              || (request.resource.data.commentId is string && request.resource.data.commentId.size() <= 80))
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 200
          && request.resource.data.read == false
          && request.resource.data.createdAt == request.time )
        // El destinatario marca su notificación como leída
        || ( isUser(recipientUid)
             && changed().hasOnly(['read'])
             && request.resource.data.read is bool )
      );

      allow delete: if isUser(recipientUid)
        || (signedIn() && resource.data.fromUid == request.auth.uid);
    }

    // ---------- Muro compartido ----------
    match /posts/{postId} {
      allow read: if true;

      allow create: if canWrite()
        // Los ids que empiezan por r_ (reseña pública de una película) solo puede crearlos su dueño
        && (!postId.matches('r_.*') || postId.matches('r_' + request.auth.uid + '_.*'))
        && request.resource.data.keys().hasOnly(['authorUid', 'author', 'avatarSeed', 'type', 'tmdbMovieId', 'movieObj',
                                                 'reviewTitle', 'title', 'content', 'rating', 'votes', 'commentCount',
                                                 'lastComment', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.type in ['review', 'discussion']
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 40
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1 && request.resource.data.content.size() <= 5000
        && request.resource.data.title.size() <= 150
        && request.resource.data.reviewTitle.size() <= 150
        && (request.resource.data.rating == null
            || (request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 10))
        && (request.resource.data.movieObj == null || request.resource.data.movieObj is map)
        && request.resource.data.votes == {}
        && request.resource.data.commentCount == 0
        && request.resource.data.lastComment == null;

      allow update: if canWrite() && (
        // 1) Quien escribió la publicación puede editar su contenido
        ( ownerOf(resource.data) == request.auth.uid
          && changed().hasOnly(['author', 'avatarSeed', 'reviewTitle', 'title', 'content', 'rating', 'movieObj', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1 && request.resource.data.content.size() <= 5000
          && request.resource.data.author.size() <= 40
          && request.resource.data.title.size() <= 150
          && request.resource.data.reviewTitle.size() <= 150
          && (request.resource.data.rating == null
              || (request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 10)) )
        // 2) Cualquier persona con sesión puede votar (solo su propio voto)
        || ( changed().hasOnly(['votes']) && onlyMyVote() )
        // 3) Al comentar o borrar un comentario se ajusta el contador (±1) y el último comentario
        || ( changed().hasOnly(['commentCount', 'lastComment'])
             && request.resource.data.commentCount >= 0
             && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                 || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1)
             && (request.resource.data.lastComment == null
                 || (request.resource.data.lastComment is map
                     && request.resource.data.lastComment.keys().hasOnly(['author', 'avatarSeed', 'text'])
                     && request.resource.data.lastComment.text.size() <= 160)) )
      );

      allow delete: if signedIn() && ownerOf(resource.data) == request.auth.uid;

      // ---------- Comentarios ----------
      match /comments/{commentId} {
        allow read: if true;

        allow create: if canWrite()
          && request.resource.data.keys().hasOnly(['authorUid', 'author', 'avatarSeed', 'text', 'parentId',
                                                   'replyToAuthor', 'votes', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.author is string
          && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && (request.resource.data.parentId == null || request.resource.data.parentId is string)
          && request.resource.data.votes == {};

        allow update: if canWrite() && (
          ( resource.data.authorUid == request.auth.uid
            && changed().hasOnly(['text', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000 )
          || ( changed().hasOnly(['votes']) && onlyMyVote() )
        );

        // Puede borrarlo quien lo escribió o quien escribió la publicación
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || ownerOf(get(/databases/$(database)/documents/posts/$(postId)).data) == request.auth.uid
        );
      }
    }
  }
}
